Checks: >
  -*,
  bugprone-*,
  performance-*,
  readability-*,
  modernize-*,
  misc-*,
  -readability-magic-numbers,
  -cppcoreguidelines-avoid-magic-numbers,
  -readability-identifier-length,
  -readability-math-missing-parentheses,
  -readability-function-cognitive-complexity,
  -readability-implicit-bool-conversion,
  -readability-use-anyofallof,
  -readability-redundant-member-init,
  -misc-non-private-member-variables-in-classes,
  -misc-const-correctness,
  -misc-use-internal-linkage,
  -misc-unused-using-decls,
  -modernize-use-trailing-return-type,
  -modernize-use-designated-initializers,
  -modernize-avoid-c-arrays,
  -bugprone-exception-escape,
  -bugprone-unchecked-optional-access,
  -bugprone-branch-clone,
  -bugprone-implicit-widening-of-multiplication-result,
  -cppcoreguidelines-pro-bounds-pointer-arithmetic,
  -cppcoreguidelines-pro-bounds-constant-array-index,
  -cppcoreguidelines-pro-type-reinterpret-cast,
  -cppcoreguidelines-pro-type-member-init,
  -cppcoreguidelines-pro-type-vararg,
  -cppcoreguidelines-pro-type-union-access,
  -cppcoreguidelines-avoid-c-arrays,
  -cppcoreguidelines-special-member-functions,
  -google-readability-todo,
  -google-build-using-namespace,
  -google-readability-braces-around-statements,
  -hicpp-signed-bitwise,
  -hicpp-vararg,
  -hicpp-avoid-c-arrays,
  -hicpp-special-member-functions,
  -hicpp-member-init,
  -hicpp-move-const-arg,
  -cert-err58-cpp,
  -llvm-include-order
HeaderFilterRegex: '^(src|include|tests)[/\\].*'
# AnalyzeTemporaryDtors: true  # commented out because some clang-tidy versions don't recognize this key
FormatStyle: file
User: CiviWave
ExtraArgs:
  - "-std=c++2c"
  - "-fno-rtti"
  - "-Wall"
  - "-Wextra"
  - "--system-header-prefix=vk_mem_alloc.h"
  - "--system-header-prefix=VulkanMemoryAllocator"
  - "-fexceptions"
  - "-misc-non-private-member-variables-in-classes"
CheckOptions:
  - key: readability-identifier-naming.NamespaceCase
    value: lower_case
  - key: readability-identifier-naming.ClassCase
    value: CamelCase
  - key: readability-identifier-naming.StructCase
    value: CamelCase
  - key: readability-identifier-naming.FunctionCase
    value: lower_case
  - key: readability-identifier-naming.VariableCase
    value: lower_case
  - key: readability-identifier-naming.MemberCase
    value: lower_case
  - key: readability-identifier-naming.PrivateMemberSuffix
    value: _
  - key: readability-identifier-naming.GlobalConstantCase
    value: CamelCase
  - key: readability-identifier-naming.GlobalConstantPrefix
    value: k
  - key: modernize-use-trailing-return-type.MinTypeNameLength
    value: '0'
